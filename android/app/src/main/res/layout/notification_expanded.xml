<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="2dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
    <TextView android:id="@+id/notice_headline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
      android:layout_marginEnd="12dp" android:textColor="@color/notification_ink" android:textSize="19sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/ic_launcher_foreground"
      android:scaleType="fitCenter" android:contentDescription="江水课表"/>
  </LinearLayout>
  <TextView android:id="@+id/notice_course" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="6dp" android:textColor="@color/notification_muted" android:textSize="15sp" android:maxLines="2" android:ellipsize="end"/>
  <TextView android:id="@+id/notice_teacher" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" android:textColor="@color/notification_muted" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
  <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="10dp" android:background="@color/notification_divider"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="10dp">
      <Chronometer android:id="@+id/notice_clock" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:textColor="@color/notification_accent" android:textSize="17sp" android:textStyle="bold" android:singleLine="true"/>
      <TextView android:id="@+id/notice_status" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:textColor="@color/notification_accent" android:textSize="17sp" android:textStyle="bold" android:maxLines="1"/>
    </FrameLayout>
    <TextView android:id="@+id/notice_action" android:layout_width="wrap_content" android:layout_height="match_parent"
      android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center" android:background="@drawable/notification_action"
      android:textColor="@color/notification_ink" android:textSize="13sp" android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
