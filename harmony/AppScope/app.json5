// 职责：HarmonyOS 应用级配置（bundleName、版本、图标、应用名）。
// 依赖方向：无代码依赖；资源引用 AppScope/resources。
// 阶段：P6；版本号与 Android/Web 线对齐（1.3.2 = versionCode 50）。
// 待确认：icon 需替换为正式 HAP 图标；schema 以 DevEco Studio API 12 模板为准。
{
  "app": {
    "bundleName": "cn.local.tomorrow",
    "vendor": "jiangshui",
    "versionCode": 50,
    "versionName": "1.3.2",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
